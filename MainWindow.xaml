<ui:FluentWindow x:Class="AirDropWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AirDropWindows"
        xmlns:models="clr-namespace:AirDropWindows.Models"
        mc:Ignorable="d"
        Title="AirDrop Windows" Height="820" Width="1220"
        MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        Background="#18181A">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Top Header Bar -->
        <Border Grid.Row="0" Background="#202023" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#0A84FF" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AirDrop Windows" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Local High-Speed Wi-Fi File Sharing for iPhone" FontSize="12" Foreground="#8E8E93"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Open Received Folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnOpenFolder_Click" Appearance="Secondary" Margin="0,0,10,0"/>
                    <ui:Button Content="Refresh Status" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="BtnRefresh_Click" Appearance="Transparent"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN: HOTSPOT & QR CODES ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>

                    <!-- Hotspot Control Card -->
                    <Border Background="#202023" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Windows Mobile Hotspot" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsHotspotActive, Mode=OneWay}" 
                                                 Checked="ToggleHotspot_Checked" Unchecked="ToggleHotspot_Unchecked"
                                                 VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Background="#2D2D30" Height="1" Margin="0,0,0,12"/>

                            <!-- SSID & Password Display -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Network (SSID):" FontWeight="Medium" Foreground="#8E8E93" Width="110" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Ssid}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy Network Name" Click="BtnCopySsid_Click" Appearance="Transparent" Padding="6"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Password:" FontWeight="Medium" Foreground="#8E8E93" Width="110" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Password}" FontWeight="SemiBold" Foreground="#0A84FF" VerticalAlignment="Center" FontFamily="Consolas"/>
                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy Password" Click="BtnCopyPassword_Click" Appearance="Transparent" Padding="6"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Web Server:" FontWeight="Medium" Foreground="#8E8E93" Width="110" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ServerUrl}" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center"/>
                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy Web Server URL" Click="BtnCopyUrl_Click" Appearance="Transparent" Padding="6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- QR Codes Card -->
                    <Border Background="#202023" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Instant iPhone Connect" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Scan with iPhone Camera app to join Wi-Fi and open the transfer web page." FontSize="12" Foreground="#8E8E93" Margin="0,2,0,14"/>

                            <!-- Two QR Codes side-by-side -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- QR 1: Wi-Fi -->
                                <Border Grid.Column="0" Background="#26262A" BorderBrush="#323238" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="1. Join Wi-Fi" FontWeight="SemiBold" FontSize="13" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <Border Width="150" Height="150" Background="White" CornerRadius="8" Padding="6">
                                            <Image Source="{Binding WiFiQrCode}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="Scan to Auto-Join" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- QR 2: Web Server URL -->
                                <Border Grid.Column="1" Background="#26262A" BorderBrush="#323238" BorderThickness="1" CornerRadius="10" Padding="12" Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="2. Open Transfer" FontWeight="SemiBold" FontSize="13" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <Border Width="150" Height="150" Background="White" CornerRadius="8" Padding="6">
                                            <Image Source="{Binding ServerUrlQrCode}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="Scan to Open Safari" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Connected Devices Card -->
                    <Border Background="#202023" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="PhoneLaptop24" FontSize="18" Foreground="#0A84FF" Margin="0,0,8,0"/>
                                    <TextBlock Text="Connected Devices" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#26262A" CornerRadius="12" Padding="8,2">
                                    <TextBlock Text="{Binding ConnectedClientsCount, StringFormat='{}{0} Active'}" FontSize="12" FontWeight="SemiBold" Foreground="#30D158"/>
                                </Border>
                            </Grid>

                            <!-- Clients List -->
                            <ItemsControl ItemsSource="{Binding ConnectedClients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#26262A" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0" Symbol="Phone24" FontSize="16" Foreground="#8E8E93" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                                    <TextBlock Text="{Binding MacAddress}" FontSize="11" Foreground="#8E8E93"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ConnectedTime, StringFormat='{}{0:HH:mm}'}" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State if no clients connected -->
                            <Border Background="#26262A" CornerRadius="8" Padding="14" HorizontalAlignment="Stretch"
                                    Visibility="{Binding ConnectedClientsCount, Converter={x:Static local:ZeroToVisibilityConverter.Instance}}">
                                <TextBlock Text="No iPhones connected yet. Turn on Mobile Hotspot and scan the Wi-Fi QR code above." 
                                           FontSize="12" Foreground="#8E8E93" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= RIGHT COLUMN: FILE SHARING & TRANSFERS ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <!-- SECTION 1: Send Files to iPhone (Drag & Drop Zone + Queued Files) -->
                <Border Grid.Row="0" Background="#202023" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Send Files to iPhone" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Files added here become instantly downloadable on the iPhone web page" FontSize="12" Foreground="#8E8E93"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="Browse Files" Icon="{ui:SymbolIcon Add24}" Click="BtnBrowseFiles_Click" Appearance="Secondary" Margin="0,0,8,0"/>
                                <ui:Button Content="Clear All" Click="BtnClearSharedFiles_Click" Appearance="Transparent"/>
                            </StackPanel>
                        </Grid>

                        <!-- Drag and Drop Dropzone -->
                        <Border Grid.Row="1" x:Name="DropZone" Height="85" CornerRadius="10" 
                                Background="#1A2233" BorderBrush="#0A84FF" BorderThickness="1.5"
                                AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave"
                                Cursor="Hand" MouseDown="DropZone_MouseDown" Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="24" Foreground="#0A84FF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Drag and Drop files here to share with iPhone" FontWeight="SemiBold" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="or click to browse from your computer" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Queued Shared Files List -->
                        <ListView Grid.Row="2" ItemsSource="{Binding SharedFiles}" Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SharedFileItem}">
                                    <Border Background="#26262A" BorderBrush="#323238" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- File Ext Badge -->
                                            <Border Grid.Column="0" Background="#0A84FF" CornerRadius="6" Padding="6,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Extension}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- File Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FormattedFileSize}" FontSize="11" Foreground="#8E8E93"/>
                                            </StackPanel>

                                            <!-- Download count badge -->
                                            <TextBlock Grid.Column="2" Text="{Binding DownloadCount, StringFormat='{}{0} downloads'}" 
                                                       FontSize="11" Foreground="#30D158" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                            <!-- Remove button -->
                                            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" 
                                                       Padding="6" Click="BtnRemoveSharedFile_Click" Tag="{Binding}" ToolTip="Remove file"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- SECTION 2: Live Transfer Status & Activity Log -->
                <Border Grid.Row="2" Background="#202023" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Foreground="#30D158" Margin="0,0,8,0"/>
                                <TextBlock Text="Live File Transfers &amp; Activity Log" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Clear Log" Click="BtnClearLog_Click" Appearance="Transparent"/>
                        </Grid>

                        <!-- Transfers ListView -->
                        <ListView Grid.Row="1" ItemsSource="{Binding Transfers}" Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TransferItem}">
                                    <Border Background="#26262A" BorderBrush="#323238" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: Direction icon, File Name, Speed, Status -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Direction Icon -->
                                                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" FontSize="18" Foreground="#30D158" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                                <!-- File Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FormattedFileSize}" FontSize="11" Foreground="#8E8E93"/>
                                                </StackPanel>

                                                <!-- Transfer Speed -->
                                                <TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="12" FontWeight="SemiBold" Foreground="#0A84FF" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="3" Background="#1C2F20" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#30D158"/>
                                                </Border>
                                            </Grid>

                                            <!-- Row 2: Progress Bar -->
                                            <Grid Grid.Row="1">
                                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Foreground="#30D158" Background="#3A3A3C"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
